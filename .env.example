# demo or aws. AWS mode requires a database imported through the CLI.
IG_SOURCE=demo
# Path to a SQLite database. Use a private folder outside the Git workspace for AWS data.
IG_DATABASE=data/demo.sqlite
# Optional comma-separated ISO 8601 resume times with offsets after known CloudTrail gaps.
IG_CLOUDTRAIL_COVERAGE_BREAKS=
# AWS dashboard only. Generate a private random token with at least 32 characters.
IG_WORKSPACE_TOKEN=
# Local multi-user login. Set a random 32-byte hexadecimal key to enable TOTP sessions.
IG_ACCESS_KEY=
# Set to 1 to fail startup if the MFA encryption key is missing or invalid.
IG_REQUIRE_ACCESS=0
# Optional DNS hostname for authenticated console access behind a TLS proxy.
IG_CONSOLE_HOST=
# Optional local Docker Compose port
IG_PORT=8000

# Optional Anthropic case analysis. Keep live values outside Git.
ANTHROPIC_API_KEY=
IG_AI_MODEL=

# Optional HMAC key for outbound test webhooks.
IG_WEBHOOK_SECRET=

# Optional password for the separate local ClickHouse search user.
IG_CLICKHOUSE_READER_PASSWORD=
